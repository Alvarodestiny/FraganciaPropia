TRAD = {k.lower(): v for k, v in TRAD.items()}


def pesos(valor):
    out = []
    for i, x in enumerate(re.split(r"[|,;]", valor or "")):
        x = x.strip()
        if not x:
            continue
        n, _, p = x.partition(":")
        out.append((n.strip(), num(p) if p else max(20, 100 - 20 * i)))
    return out


def estaciones(f):
    v = {"invierno": num(f.get("winter")), "primavera": num(f.get("spring")), "verano": num(f.get("summer")), "otoño": num(f.get("autumn"))}
    t = sum(v.values())
    return [s for s in sorted(v, key=lambda s: -v[s]) if t and v[s] / t >= 0.28][:2]


def momento(f):
    d, n = num(f.get("day")), num(f.get("night"))
    if d + n == 0:
        return []
    p = d / (d + n)
    return ["mañana", "tarde"] if p >= 0.6 else ["noche"] if p <= 0.4 else ["tarde", "noche"]


def intensidad(f):
    s = num(f.get("sillage_avg"))
    return 0 if not s else 1 if s < 2.15 else 2 if s < 2.45 else 3


def familias(acordes):
    puntos = {}
    for nombre, peso in acordes[:8]:
        f = REV.get(nombre.lower())
        if f:
            puntos[f] = puntos.get(f, 0) + peso
    if not puntos:
        return []
    mejor = max(puntos.values())
    return [f for f in sorted(puntos, key=lambda f: -puntos[f]) if puntos[f] >= mejor * 0.35][:3]


def unicos(items, tope=2):
    out = []
    for x in items:
        if x not in out:
            out.append(x)
    return out[:tope]


def rango(marca, precio):
    m = norm(marca)
    en = lambda L: any(m == x or m.startswith(x + " ") for x in L)
    if en(NICHO):
        return "n"
    if en(ECON) or (precio and precio <= 60):
        return "e"
    return "d"


def cargar_feed(ruta):
    filas = leer(ruta)
    if not filas:
        sys.exit("El feed está vacío")
    c = {k: buscar(filas[0].keys(), v) for k, v in FEED.items()}
    if not c["nombre"] or not c["marca"]:
        sys.exit("No encuentro nombre/marca en el feed. Columnas: " + ", ".join(filas[0].keys()))
    feed = {}
    for f in filas:
        marca = f[c["marca"]]
        feed.setdefault(clave(f[c["nombre"]], marca), {
            "u": f.get(c["url"], "") if c["url"] else "",
            "p": num(f.get(c["precio"])) if c["precio"] else 0,
            "img": f.get(c["img"], "") if c["img"] else "",
        })
    return feed


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("dataset")
    ap.add_argument("--feed")
    ap.add_argument("--solo-notino", action="store_true")
    ap.add_argument("--salida", default="catalogo.json")
    ap.add_argument("--min-votos", type=int, default=300)
    ap.add_argument("--max-por-rango", type=int, default=400)
    a = ap.parse_args()

    filas = leer(a.dataset)
    if not filas:
        sys.exit("El dataset está vacío")
    cab = list(filas[0].keys())
    c = {k: buscar(cab, v) for k, v in COLUMNAS.items()}
    cols_acorde = sorted(x for x in cab if x.lower().startswith("mainaccord") and "percent" not in x.lower())
    if not c["nombre"] or not c["marca"] or not (cols_acorde or c["acordes"]):
        sys.exit("No encuentro nombre, marca o acordes. Columnas de tu CSV:\n" + ", ".join(cab))

    feed = cargar_feed(a.feed) if a.feed else {}
    catalogo, vistos = [], set()
    for f in filas:
        marca = limpia(f[c["marca"]])
        nombre = limpia(f[c["nombre"]], marca)
        if not nombre or not marca:
            continue
        votos = num(f.get(c["votos"])) if c["votos"] else 0
        if votos < a.min_votos and c["votos"]:
            continue
        k = clave(nombre, marca)
        if k in vistos:
            continue
        en_feed = feed.get(k)
        if a.solo_notino and feed and not en_feed:
            continue
        acordes = pesos(f.get(c["acordes"])) if c["acordes"] else [(f[x], 100 - 20 * i) for i, x in enumerate(cols_acorde) if f.get(x)]
        fam = familias(acordes)
        if not fam:
            continue
        vistos.add(k)
        notas = []
        for campo in ("top", "medio", "base"):
            if c[campo]:
                ps = sorted(pesos(f.get(c[campo])), key=lambda x: -x[1])[:2]
                notas += [TRAD.get(n.lower(), n.lower()) for n, _ in ps]
        notas = unicos(notas, 6)
        rec = {
            "n": nombre, "b": marca,
            "t": rango(marca, en_feed["p"] if en_feed else 0),
            "g": genero(f.get(c["genero"]) if c["genero"] else ""),
            "k": fam,
            "s": estaciones(f) or unicos(x for q in fam[:2] for x in SEASONS[q]),
            "h": momento(f) or unicos(x for q in fam[:2] for x in HOURS[q]),
            "i": intensidad(f) or round(sum(INTENS[q] for q in fam[:2]) / len(fam[:2])),
            "d": ("Notas: " + ", ".join(notas) + ".") if notas else "",
            "v": int(votos),
        }
        if c["url"] and f.get(c["url"]):
            rec["f"] = f[c["url"]]
        if en_feed:
            rec.update({x: en_feed[x] for x in ("u", "p", "img") if en_feed[x]})
        catalogo.append(rec)

    final = []
    for t in "edn":
        grupo = sorted((r for r in catalogo if r["t"] == t), key=lambda r: -r["v"])[: a.max_por_rango]
        final += grupo
        print(f"{t}: {len(grupo)} perfumes")
    for r in final:
        r.pop("v")
    with open(a.salida, "w", encoding="utf-8") as out:
        json.dump(final, out, ensure_ascii=False, separators=(",", ":"))
    print(f"Escrito {a.salida} con {len(final)} perfumes")
    if not feed:
        print("Aviso: sin feed, el rango se decide solo por marca (las marcas no listadas salen como diseñador).")


if __name__ == "__main__":
    main()
