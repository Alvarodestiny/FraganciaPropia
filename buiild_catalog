csv.field_size_limit(10**8)


def leer(ruta):
    for enc in ("utf-8-sig", "latin-1"):
        try:
            with open(ruta, newline="", encoding=enc) as f:
                sep = max(";,|\t", key=f.readline().count)
                f.seek(0)
                return list(csv.DictReader(f, delimiter=sep))
        except UnicodeDecodeError:
            continue
    sys.exit("No pude leer " + ruta)


def buscar(cabeceras, candidatas):
    bajas = {c.lower().strip(): c for c in cabeceras}
    for c in candidatas:
        if c in bajas:
            return bajas[c]
    return None


def norm(s):
    s = unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode().lower()
    s = re.sub(r"\b(eau de parfum|eau de toilette|parfum|edp|edt|for (wo)?men( and men)?|pour (homme|femme))\b", " ", s)
    return re.sub(r"[^a-z0-9]+", " ", s).strip()


def clave(nombre, marca):
    n, m = norm(nombre), norm(marca)
    if m and n.endswith(" " + m):
        n = n[: -len(m)].strip()
    return m + "|" + n


def limpia(texto, marca=""):
    t = (texto or "").strip()
    if " " not in t and "-" in t:  # slug tipo "coco-mademoiselle"
        t = t.replace("-", " ")
    if t.islower():
        t = re.sub(r"(^|[\s-])([a-z])", lambda m: m.group(1) + m.group(2).upper(), t)
    t = re.sub(r"\s+for (wo)?men( and men)?$", "", t, flags=re.I)
    if marca and t.lower().endswith(" " + marca.lower()):
        t = t[: -len(marca) - 1]
    return t.strip().replace("'", "’")


def num(s):
    m = re.search(r"\d+(?:[.,]\d+)?", str(s or ""))
    return float(m.group(0).replace(",", ".")) if m else 0.0


def genero(v):
    v = (v or "").lower()
    if "unisex" in v or ("women" in v and "men" in v.replace("women", "")):
        return "u"
    if "women" in v or "female" in v or "femin" in v:
        return "f"
    if "men" in v or "male" in v or "mascul" in v:
        return "m"
    return "u"


def lista(valor):
    return [x.strip() for x in re.split(r"[,;|]", valor or "") if x.strip()]


